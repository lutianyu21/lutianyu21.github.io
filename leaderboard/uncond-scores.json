  "score_metric": {
    "key": "score",
    "label": "Score",
    "direction": "higher",
    "scale": [
      0,
      100
    ],
    "unit": "percent",
    "formula": "100 * count(plddt > 70 and ptm > 0.5 and repeat < 0.1) / count(all sequences)",
    "thresholds": {
      "plddt": {
        "operator": ">",
        "value": 70
      },
      "ptm": {
        "operator": ">",
        "value": 0.5
      },
      "repeat": {
        "operator": "<",
        "value": 0.1
      }
    },
    "combination": "and"
  },
  "aggregation": "Score is the percentage of all sequences jointly satisfying pLDDT > 70, pTM > 0.5 and Repeat < 10%. pAE is not evaluated. pLDDT, pTM and PPL are arithmetic means over all sequences. Repetition metrics are mean per-sequence fractions multiplied by 100; no length-specific metric columns.",
  "folding_protocol": {
    "engine": "per-model",
    "metrics": [
      "plddt",
      "ptm"
    ],
    "source": "Top-level JSONL scores. See each model folding_engine; ESMFold2-Fast sources do not specify the detailed folding configuration."
  },
