  "score_metric": {
    "key": "score",
    "label": "Score",
    "direction": "higher",
    "scale": [
      0,
      100
    ],
    "unit": "percent",
    "formula": "100 * count(plddt > 80 and ptm > 0.7) / count(all sequences)",
    "thresholds": {
      "plddt": {
        "operator": ">",
        "value": 80
      },
      "ptm": {
        "operator": ">",
        "value": 0.7
      }
    },
    "combination": "and"
  },
  "aggregation": "Score is the percentage of all sequences jointly satisfying pLDDT > 80 and pTM > 0.7. pAE is not evaluated; Repeat is not a Score filter. pLDDT, pTM and PPL are arithmetic means over all sequences. Repetition metrics are mean per-sequence fractions multiplied by 100; no length-specific metric columns.",
